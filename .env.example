# Généré par la config Docker — ne pas committer de secrets réels.
# Copier en .env et renseigner.

POSTGRES_PASSWORD=itsm_dev_pw
JWT_SECRET=change-me
AI_API_URL=http://192.168.0.20:11434
AI_MODEL=qwen3:8b
AI_CODER_MODEL=qwen2.5-coder:latest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=itsm@twisterlab.local
TEAMS_WEBHOOK=
NOTIFY_EMAIL=ops@twisterlab.local
SLA_TIMER_MS=60000
# Piste 2 (Option C) — relais webhook vers TwisterLab : URL du récepteur
# (POST /api/v1/events/itsm) et clé partagée X-Events-Key.
# Si EVENTS_WEBHOOK_URL vide => dry-run (log, aucun appel réseau).
EVENTS_WEBHOOK_URL=
EVENTS_WEBHOOK_SECRET=
